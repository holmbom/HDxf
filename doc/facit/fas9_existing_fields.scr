;SAVE blockcolors
;
; --- Vertex identifiers: AUTOCONSTRAIN gives every vertex of a polyline its own; reversed, chamfered (new vertices
; have none), a second polyline, broken (a vertex gone, the others keep theirs) and converted to a heavy POLYLINE
_.RECTANG
180,0
250,35
_.AUTOCONSTRAIN
_L

_.REGENALL
;SAVE vertexids
_.PEDIT
_L
_Reverse

;SAVE vertexids reversed
_.CHAMFER
_Distance
5
5
_.CHAMFER
_Polyline
_L
;SAVE vertexids chamfered
_.PLINE
0,100
40,100
80,100
80,140

_.AUTOCONSTRAIN
_L

;SAVE vertexids collinear
_.BREAK
_L
20,100
60,100
;SAVE vertexids broken
_.CONVERTPOLY
_Heavy
_All

;SAVE vertexids heavy
