; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 09_images.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Shared IMAGEDEF instances, ASCII/Unicode resource paths, rectangle/polygon IMAGECLIP, WIPEOUT and clipped PDF underlay from doc/facit/underlay.pdf (a PDF of your own, page 1).
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(fx:need (findfile (strcat fx:base "raster.bmp")) "Missing raster.bmp next to this script")
(setq fx:im1 (vla-AddRaster fx:ms (strcat fx:base "raster.bmp") (fx:p '(0.0 0.0 0.0)) 80.0 0.0))
(setq fx:im2 (vla-AddRaster fx:ms (strcat fx:base "raster.bmp") (fx:p '(100.0 0.0 0.0)) 80.0 0.2))
(setq fx:upath (strcat fx:base "raster_" (chr 229) ".bmp"))
(fx:need (findfile fx:upath) "Missing raster with Swedish filename")
(setq fx:im3 (vla-AddRaster fx:ms fx:upath (fx:p '(200.0 0.0 0.0)) 80.0 0.0))
(vla-ScaleEntity fx:im1 (fx:p '(0.0 0.0 0.0)) (/ 80.0 (vla-get-ImageWidth fx:im1)))
(vla-ScaleEntity fx:im2 (fx:p '(100.0 0.0 0.0)) (/ 80.0 (vla-get-ImageWidth fx:im2)))
(vla-ScaleEntity fx:im3 (fx:p '(200.0 0.0 0.0)) (/ 80.0 (vla-get-ImageWidth fx:im3)))
(command "_.IMAGECLIP" (vlax-vla-object->ename fx:im1) "_New" "_Rectangular" "10,10" "65,65")
(fx:idle)
(command "_.IMAGECLIP" (vlax-vla-object->ename fx:im2) "_New" "_Polygonal" "110,10" "160,20" "155,60" "115,65" "")
(fx:idle)
(command "_.WIPEOUT" "0,100" "70,100" "60,150" "10,155" "_Close")
(fx:idle)
(fx:need (findfile (strcat fx:base "underlay.pdf")) "Missing doc/facit/underlay.pdf")
(command "_.-PDFATTACH" (strcat fx:base "underlay.pdf") "1" "100,100,0" "0.2" "0")
(fx:idle)
(setq fx:pdf1 (entlast))
(setq fx:pdfobj (vlax-ename->vla-object fx:pdf1))
(vla-ScaleEntity fx:pdfobj (fx:p '(100.0 100.0 0.0)) (/ 80.0 (vla-get-Width fx:pdfobj)))
(command "_.PDFCLIP" fx:pdf1 "_New" "_Rectangular" "105,105" "135,140")
(fx:idle)
(command "_.-PDFATTACH" (strcat fx:base "underlay.pdf") "1" "180,100,0" "0.2" "15")
(fx:idle)
(setq fx:pdfobj2 (vlax-ename->vla-object (entlast)))
(vla-ScaleEntity fx:pdfobj2 (fx:p '(180.0 100.0 0.0)) (/ 80.0 (vla-get-Width fx:pdfobj2)))
(fx:type "IMAGE")
(fx:type "WIPEOUT")
(fx:type "PDFUNDERLAY")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_images.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_images_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(vla-Delete fx:im2)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_images_image_removed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_images_image_removed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 09_images\n")
