; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 06_hatch.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Associative/nonassociative patterns, SOLID, two-color gradient, islands and spline/arc boundaries; boundary edit/removal snapshots.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(defun fx:hatch (outer inner name associative / h) (setq h (vla-AddHatch fx:ms 0 name associative 0)) (vla-AppendOuterLoop h (fx:a outer 9)) (if inner (vla-AppendInnerLoop h (fx:a inner 9))) (vla-Evaluate h) h)
(setq fx:boundary (fx:rect 0.0 0.0 90.0 60.0) fx:island (vla-AddCircle fx:ms (fx:p '(45.0 30.0 0.0)) 12.0))
(setq fx:h1 (fx:hatch (list fx:boundary) (list fx:island) "ANSI31" :vlax-true))
(vla-put-PatternScale fx:h1 2.5)
(vla-put-PatternAngle fx:h1 0.3)
(vla-Evaluate fx:h1)
(setq fx:b2 (fx:rect 110.0 0.0 80.0 60.0))
(fx:hatch (list fx:b2) nil "SOLID" :vlax-false)
(setq fx:b3 (fx:rect 210.0 0.0 80.0 60.0))
(setq fx:gradient (vla-AddHatch fx:ms 0 "LINEAR" :vlax-false 1))
(vla-AppendOuterLoop fx:gradient (fx:a (list fx:b3) 9))
(setq fx:c1 (vla-get-TrueColor fx:gradient) fx:c2 (vla-get-TrueColor fx:gradient))
(vla-SetRGB fx:c1 240 40 20)
(vla-SetRGB fx:c2 20 80 240)
(vla-put-GradientColor1 fx:gradient fx:c1)
(vla-put-GradientColor2 fx:gradient fx:c2)
(vla-put-GradientAngle fx:gradient 0.4)
(vla-Evaluate fx:gradient)
(setq fx:ellipse (vla-AddEllipse fx:ms (fx:p '(45.0 110.0 0.0)) (fx:p '(40.0 0.0 0.0)) 0.5))
(fx:hatch (list fx:ellipse) nil "ANSI32" :vlax-false)
(setvar "SPLMETHOD" 0)
(command "_.SPLINE" "120,90" "155,85" "185,110" "155,140" "120,120" "_Close" "")
(fx:idle)
(setq fx:spline (vlax-ename->vla-object (entlast)))
(fx:hatch (list fx:spline) nil "ANSI31" :vlax-true)
(fx:type "HATCH")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_hatch.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_hatch_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(vla-Move fx:island (fx:p '(0.0 0.0 0.0)) (fx:p '(5.0 0.0 0.0)))
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_hatch_boundary_moved.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_hatch_boundary_moved_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(vla-Delete fx:island)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_hatch_boundary_removed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_hatch_boundary_removed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 06_hatch\n")
