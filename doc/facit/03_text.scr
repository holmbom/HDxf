; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 03_text.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; All TEXT justifications, SHX/TrueType styles, formatted and long MTEXT, static/dynamic columns, background/frame, TOLERANCE.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(fx:style "HDXF_SHX" "simplex.shx")
(setq fx:tt (vla-Add (vla-get-TextStyles fx:doc) "HDXF_ARIAL"))
(vla-SetFont fx:tt "Arial" :vlax-false :vlax-false 0 34)
; Baseline Left/Center/Right/Aligned/Middle/Fit plus TL/TC/TR/ML/MC/MR/BL/BC/BR.
(setq fx:n 0)
(foreach j '((0 0 "Left") (1 0 "Center") (2 0 "Right") (3 0 "Aligned") (4 0 "Middle") (5 0 "Fit") (0 3 "TL") (1 3 "TC") (2 3 "TR") (0 2 "ML") (1 2 "MC") (2 2 "MR") (0 1 "BL") (1 1 "BC") (2 1 "BR")) (setq fx:y (* -10.0 fx:n)) (fx:e (list '(0 . "TEXT") '(8 . "0") '(7 . "HDXF_SHX") (cons 10 (list 0.0 fx:y 0.0)) (cons 11 (list 65.0 fx:y 0.0)) '(40 . 3.0) (cons 1 (caddr j)) (cons 72 (car j)) (cons 73 (cadr j)))) (setq fx:n (1+ fx:n)))
(fx:e '((0 . "TEXT") (7 . "HDXF_ARIAL") (10 100.0 0.0 0.0) (40 . 5.0) (41 . 1.25) (50 . 0.35) (51 . 0.2) (1 . "Arial AAgj - TrueType") (71 . 2)))
(setq fx:mt (vla-AddMText fx:ms (fx:p '(100.0 -20.0 0.0)) 75.0 "{\\fArial|b1|i0;Bold} \\Lunderline\\l \\Ooverline\\o\\P\\C1;Red \\c255;RGB \\H1.5x;Tall \\W0.8;Narrow\\PStack \\S1/2; \\S+0.1^-0.2; \\U+00B0 \\U+2300"))
(vla-put-StyleName fx:mt "HDXF_ARIAL")
(vla-put-Height fx:mt 3.0)
(vla-put-BackgroundFill fx:mt :vlax-true)
(fx:put (vlax-vla-object->ename fx:mt) 90 19)
(setq fx:long "")
(repeat 30 (setq fx:long (strcat fx:long "Long MTEXT tests group 3/1 splitting. ")))
(vla-AddMText fx:ms (fx:p '(100.0 -90.0 0.0)) 120.0 fx:long)
; MTEXT columns through the MTEXT command (static/dynamic, manual height): the DXF group codes 75-79 cannot be entmade.
(setvar "TEXTSTYLE" "HDXF_ARIAL")
(setvar "TEXTSIZE" 3.0)
(setq fx:lines '("One: first paragraph." "Second paragraph with more text in it." "Third paragraph, longer text to make the text flow." "Fourth paragraph." "Fifth paragraph with some more words." "Sixth paragraph." "Seventh paragraph, flowing further." "Eighth paragraph." "Ninth paragraph with a longer line of text." "Tenth paragraph." "Eleventh paragraph." "Twelfth paragraph." "Thirteenth paragraph." "Fourteenth paragraph." "Fifteenth paragraph." "Sixteenth paragraph."))
(defun fx:mcols (x y static count rot / args) (setq args (list "_.MTEXT" (strcat (rtos x 2 1) "," (rtos y 2 1)))) (if rot (setq args (append args (list "_Rotation" (rtos rot 2 2))))) (setq args (append args (list "_Columns") (if static (list "_Static" (rtos (+ (* count 35.0) (* (1- count) 5.0)) 2 1) (itoa count) "5" "30") (list "_Dynamic" "35" "5" "30")) fx:lines (list ""))) (apply 'command args) (fx:idle) (entlast))
(setq fx:col2 (fx:mcols 0.0 -180.0 T 2 nil))
(setq fx:col3 (fx:mcols 100.0 -180.0 T 3 11.5))
(vla-put-BackgroundFill (vlax-ename->vla-object fx:col3) :vlax-true)
(fx:mcols 250.0 -180.0 nil 2 nil)
(fx:mcols 350.0 -180.0 nil 3 -8.0)
(vla-AddTolerance fx:ms "{\\Fgdt;j}%%v0.05%%vA%%vB" (fx:p '(100.0 30.0 0.0)) (fx:p '(1.0 0.0 0.0)))
(fx:type "TEXT")
(fx:type "MTEXT")
(fx:type "TOLERANCE")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_text.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_text_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 03_text\n")
