; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 11_surfaces.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Planar/extruded/revolved/swept/lofted and converted NURBS surfaces, associative source curves, HELIX, mesh primitives and smoothed/creased mesh; ACIS BODY import probe.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setvar "SURFACEASSOCIATIVITY" 1)
(setvar "SURFACEMODELINGMODE" 0)
(setvar "ISOLINES" 8)
(command "_.PLANESURF" "0,0,0" "40,30")
(fx:idle)
(setq fx:plane (entlast))
(command "_.LINE" "60,0,0" "90,10,0" "")
(fx:idle)
(command "_.EXTRUDE" (entlast) "" "30")
(fx:idle)
(command "_.LINE" "120,0,0" "135,10,30" "")
(fx:idle)
(command "_.REVOLVE" (entlast) "" "110,0,0" "110,0,30" "300")
(fx:idle)
(command "_.LINE" "160,0,0" "170,0,0" "")
(fx:idle)
(setq fx:profile (entlast))
(vla-Add3DPoly fx:ms (fx:a '(165.0 0.0 0.0 180.0 20.0 20.0 190.0 40.0 30.0) 5))
(command "_.SWEEP" fx:profile "" (entlast))
(fx:idle)
(setq fx:ls1 (vla-AddSpline fx:ms (fx:a '(0.0 70.0 0.0 20.0 80.0 0.0 40.0 70.0 0.0) 5) (fx:p '(1.0 0.0 0.0)) (fx:p '(1.0 0.0 0.0))))
(setq fx:ls2 (vla-AddSpline fx:ms (fx:a '(0.0 70.0 20.0 20.0 90.0 25.0 40.0 70.0 20.0) 5) (fx:p '(1.0 0.0 0.0)) (fx:p '(1.0 0.0 0.0))))
(setq fx:ls3 (vla-AddSpline fx:ms (fx:a '(0.0 75.0 40.0 20.0 85.0 50.0 40.0 75.0 40.0) 5) (fx:p '(1.0 0.0 0.0)) (fx:p '(1.0 0.0 0.0))))
(command "_.LOFT" (vlax-vla-object->ename fx:ls1) (vlax-vla-object->ename fx:ls2) (vlax-vla-object->ename fx:ls3) "" "")
(fx:idle)
(setq fx:loft (vlax-ename->vla-object (entlast)))
(setq fx:nurbs (vla-Copy fx:loft))
(vla-Move fx:nurbs (fx:p '(0.0 0.0 0.0)) (fx:p '(65.0 0.0 0.0)))
(command "_.CONVTONURBS" (vlax-vla-object->ename fx:nurbs) "")
(fx:idle)
(command "_.HELIX" "140,80,0" "15" "8" "_Turns" "4.5" "50")
(fx:idle)
(command "_.MESH" "_Box" "0,150,0" "30,175,0" "25")
(fx:idle)
(setq fx:mesh (entlast))
(command "_.MESHSMOOTHMORE" fx:mesh "")
(fx:idle)
(command "_.MESHSMOOTHMORE" fx:mesh "")
(fx:idle)
(command "_.MESH" "_Sphere" "65,160,15" "15")
(fx:idle)
(command "_.MESH" "_Cylinder" "110,160,0" "12" "30")
(fx:idle)
(command "_.MESH" "_Cone" "155,160,0" "15" "30")
(fx:idle)
(command "_.MESH" "_Torus" "205,160,15" "15" "5")
(fx:idle)
; Export/import an OPEN native surface: ACISIN may yield BODY, depending on AutoCAD's importer.
(setq fx:satpath (strcat fx:base "surface_body_probe.sat"))
(if (findfile fx:satpath) (vl-file-delete fx:satpath))
(command "_.ACISOUT" fx:plane "" fx:satpath)
(fx:idle)
(command "_.ACISIN" fx:satpath)
(fx:idle)
(if (ssget "_X" '((0 . "BODY"))) (princ "\nBODY created by native ACISIN.\n") (princ "\nBODY probe returned a surface; no BODY facit claimed. See coverage.md.\n"))
(fx:type "PLANESURFACE")
(fx:type "EXTRUDEDSURFACE")
(fx:type "REVOLVEDSURFACE")
(fx:type "SWEPTSURFACE")
(fx:type "LOFTEDSURFACE")
(fx:type "NURBSURFACE")
(fx:type "HELIX")
(fx:type "MESH")
; Extra native associations: patch, network, offset, trim with a hole, extension and blend.
(setq fx:patchboundary (fx:rect 260.0 0.0 40.0 30.0))
(command "_.SURFPATCH" "_CUrves" (vlax-vla-object->ename fx:patchboundary) "" "")
(fx:idle)
(setq fx:n1 (vla-AddLine fx:ms (fx:p '(260.0 60.0 0.0)) (fx:p '(300.0 60.0 0.0))) fx:n2 (vla-AddLine fx:ms (fx:p '(260.0 90.0 10.0)) (fx:p '(300.0 90.0 10.0))))
(setq fx:n3 (vla-AddLine fx:ms (fx:p '(260.0 60.0 0.0)) (fx:p '(260.0 90.0 10.0))) fx:n4 (vla-AddLine fx:ms (fx:p '(300.0 60.0 0.0)) (fx:p '(300.0 90.0 10.0))))
(command "_.SURFNETWORK" (vlax-vla-object->ename fx:n1) (vlax-vla-object->ename fx:n2) "" (vlax-vla-object->ename fx:n3) (vlax-vla-object->ename fx:n4) "")
(fx:idle)
(command "_.SURFOFFSET" fx:plane "" "10")
(fx:idle)
(command "_.PLANESURF" "330,0,0" "390,50")
(fx:idle)
(setq fx:trimmed (entlast) fx:hole (vla-AddCircle fx:ms (fx:p '(360.0 25.0 0.0)) 10.0))
(command "_.SURFTRIM" fx:trimmed "" (vlax-vla-object->ename fx:hole) "" "360,25,0" "")
(fx:idle)
(command "_.PLANESURF" "330,80,0" "370,110")
(fx:idle)
(setq fx:blend1 (entlast))
(command "_.PLANESURF" "400,80,0" "440,110")
(fx:idle)
(setq fx:blend2 (entlast))
(command "_.ZOOM" "_Window" "320,70" "450,120")
(fx:idle)
(command "_.SURFBLEND" "370,95" "" "400,95" "" "")
(fx:idle)
(command "_.SURFEXTEND" "440,95" "" "10" "")
(fx:idle)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_surfaces.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_surfaces_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 11_surfaces\n")
