; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 18_render_modeldoc.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Native RapidRT preset/IBL environment with HDR, nonzero rotation and background toggle; DETAIL/SECTION ModelDoc styles with distinct display names/flags.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
; Native constructors supply the fields AutoCAD needs. Edits address a subclass and occurrence, never an inferred raw payload.
; IBL and RapidRT presets are native objects: IBLENVIRONMENT creates the IBL background, -RENDERPRESETS selects a native preset. DETAIL/SECTION styles: the native Imperial24 objects get their own display name and flags (new style objects cannot be made by script).
; Not scriptable (see coverage.md): a custom render preset, the view background link (VIEW 332) and the HDR rotation dialog; the HDR path/rotation are edited on the native object.
(defun fx:style-edit (dictname display flags / dd e) (setq dd (dictsearch (namedobjdict) dictname)) (fx:need dd (strcat "Missing dictionary " dictname)) (setq e (cdr (assoc -1 (dictsearch (cdr (assoc -1 dd)) (cdr (assoc 3 dd)))))) (fx:field e "AcDbModelDocViewStyle" 300 0 display) (fx:field e "AcDbModelDocViewStyle" 90 0 flags) e)
(command "_.BOX" "0,0,0" "30,20" "20")
(fx:idle)
(setvar "RENDERTARGET" 1)
(setvar "RENDERLEVEL" 8)
(setvar "IBLENVIRONMENT" 3)
(command "_.-RENDERPRESETS" "_High")
(fx:idle)
(setq fx:bd (dictsearch (namedobjdict) "ACAD_BACKGROUND"))
(fx:need fx:bd "IBLENVIRONMENT did not create ACAD_BACKGROUND")
(setq fx:ible (cdr (assoc -1 (dictsearch (cdr (assoc -1 fx:bd)) (cdr (assoc 3 fx:bd))))))
(fx:need (findfile (strcat fx:base "environment.hdr")) "Missing environment.hdr")
(fx:field fx:ible "AcDbIBLBackground" 1 0 (strcat fx:base "environment.hdr"))
(fx:field fx:ible "AcDbIBLBackground" 40 0 27.5)
(fx:field fx:ible "AcDbIBLBackground" 290 1 1)
(command "_.-VIEW" "_Save" "HDXF_RENDER")
(fx:idle)
(setq fx:detail (fx:style-edit "ACAD_DETAILVIEWSTYLE" "HDxf detail display name" 3))
(setq fx:section (fx:style-edit "ACAD_SECTIONVIEWSTYLE" "HDxf section display name" 5))
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_render_modeldoc.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_render_modeldoc_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(fx:field fx:ible "AcDbIBLBackground" 290 1 0)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_render_modeldoc_ibl_background_off.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_render_modeldoc_ibl_background_off_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 18_render_modeldoc\n")
