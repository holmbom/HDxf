; Run in a NEW EMPTY acad.dwt drawing. AutoCAD 2025, SCRIPT this file.
; Command-line columns: static, dynamic with MTEXTCOLUMN=1, and dynamic with =2.
; Verified AutoCAD output: BOTH Dynamic cases have auto-height=1, despite =2.
; 2018 Embedded Object: 71=2, 73=1; older XDATA: 75=2, 79=1. See coverage.md.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:base "C:/HDxf/doc/facit/" fx:oldcolumn (getvar "MTEXTCOLUMN"))
(defun fx:need (ok message) (if (not ok) (progn (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish. Inspect F2."))))
(defun fx:save (theme / pair v path) (foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_" theme ".dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_" theme "_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path))))
(defun fx:mcols (point rotation mode column / before args) (setvar "MTEXTCOLUMN" column) (setq before (entlast) args (list "_.-MTEXT" point "_Rotation" rotation "_Columns")) (setq args (append args (if (= mode "_Static") (list mode "75" "2" "5" "30") (list mode "35" "5" "30")) (list "One: first paragraph." "Second paragraph with more words in it." "Third paragraph, long enough to flow to another line." "Fourth paragraph." "Fifth paragraph with additional words." "Sixth paragraph." "Seventh paragraph." "Eighth paragraph." "Ninth paragraph." "Tenth paragraph." "Eleventh paragraph." "Twelfth paragraph." ""))) (apply 'command args) (fx:idle) (fx:need (and (/= before (entlast)) (= (cdr (assoc 0 (entget (entlast)))) "MTEXT")) "No MTEXT created"))
(defun fx:run () (fx:need (= 0 (vla-get-Count (vla-get-ModelSpace (vla-get-ActiveDocument (vlax-get-acad-object))))) "A new empty acad.dwt drawing is required") (setvar "OSMODE" 0) (setvar "DYNMODE" 0) (setvar "TILEMODE" 1) (setvar "TEXTSTYLE" "Standard") (setvar "TEXTSIZE" 3.0) (command "_.UCS" "_World") (fx:idle) (fx:mcols "0,0" "0" "_Static" 2) (fx:mcols "120,0" "15" "_Dynamic" 1) (fx:mcols "240,0" "-10" "_Dynamic" 2) (command "_.REGENALL") (fx:idle) (fx:save "mtext_columns"))
(setq fx:result (vl-catch-all-apply 'fx:run nil))
(setvar "MTEXTCOLUMN" fx:oldcolumn)
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(if (vl-catch-all-error-p fx:result) (princ (strcat "\nFEL 25_mtext_columns: " (vl-catch-all-error-message fx:result) "\n")) (princ "\nKLAR 25_mtext_columns\n"))
