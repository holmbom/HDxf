; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 10_solids.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Native ACIS primitives/history, extrude/revolve/sweep/loft, boolean union/subtraction, REGION, disconnected lump solid and ACIS in block/paper.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setvar "SOLIDHIST" 1)
(defun fx:last () (vlax-ename->vla-object (entlast)))
(command "_.BOX" "0,2.5,0" "20,17.5" "20")
(fx:idle)
(setq fx:box (fx:last))
(command "_.SPHERE" "50,10,10" "12")
(fx:idle)
(command "_.CYLINDER" "90,10,0" "10" "25")
(fx:idle)
(command "_.CONE" "130,10,0" "12" "30")
(fx:idle)
(command "_.TORUS" "170,10,12" "15" "4")
(fx:idle)
(command "_.WEDGE" "197.5,0,0" "222.5,20" "20")
(fx:idle)
(command "_.PYRAMID" "_Sides" "5" "250,10,0" "15" "25")
(fx:idle)
(setq fx:r (fx:rect 0.0 60.0 30.0 20.0))
(command "_.REGION" (vlax-vla-object->ename fx:r) "")
(fx:idle)
(setq fx:region (entlast))
(command "_.EXTRUDE" fx:region "" "25")
(fx:idle)
(setq fx:revolveProfile (fx:rect 60.0 60.0 12.0 25.0))
(command "_.REVOLVE" (vlax-vla-object->ename fx:revolveProfile) "" "50,60,0" "50,85,0" "270")
(fx:idle)
(setq fx:sweepProfile (vla-AddCircle fx:ms (fx:p '(100.0 60.0 0.0)) 4.0))
(vla-Add3DPoly fx:ms (fx:a '(100.0 60.0 0.0 115.0 70.0 20.0 135.0 85.0 35.0) 5))
(setq fx:sweepPath (entlast))
(command "_.SWEEP" (vlax-vla-object->ename fx:sweepProfile) "" fx:sweepPath)
(fx:idle)
(setq fx:loft1 (vla-AddCircle fx:ms (fx:p '(180.0 70.0 0.0)) 12.0) fx:loft2 (vla-AddCircle fx:ms (fx:p '(185.0 70.0 20.0)) 8.0) fx:loft3 (vla-AddCircle fx:ms (fx:p '(180.0 75.0 40.0)) 15.0))
(command "_.LOFT" (vlax-vla-object->ename fx:loft1) (vlax-vla-object->ename fx:loft2) (vlax-vla-object->ename fx:loft3) "" "")
(fx:idle)
(command "_.BOX" "5,130,0" "35,160" "24")
(fx:idle)
(setq fx:u1 (entlast))
(command "_.SPHERE" "32,145,12" "18")
(fx:idle)
(setq fx:u2 (entlast))
(command "_.UNION" fx:u1 fx:u2 "")
(fx:idle)
(setq fx:u1 (entlast))
(command "_.CYLINDER" "20,145,-10" "6" "50")
(fx:idle)
(setq fx:cut (entlast))
(command "_.SUBTRACT" fx:u1 "" fx:cut "")
(fx:idle)
; Edge-history probes use a known top edge and native FILLETEDGE/CHAMFEREDGE.
(command "_.BOX" "270,60,0" "290,80" "20")
(fx:idle)
(setq fx:fbox (fx:last))
(command "_.-VIEW" "_SWIso")
(command "_.ZOOM" "_Object" (vlax-vla-object->ename fx:fbox) "")
(command "_.FILLETEDGE" "_Radius" "2" "280,60,20" "" "")
(fx:idle)
(command "_.BOX" "310,60,0" "330,80" "20")
(fx:idle)
(setq fx:cbox (fx:last))
(command "_.ZOOM" "_Object" (vlax-vla-object->ename fx:cbox) "")
(command "_.CHAMFEREDGE" "_Distance" "2" "3" "320,60,20" "" "")
(fx:idle)
(command "_.-VIEW" "_Top")
(command "_.ZOOM" "_Extents")
(fx:idle)
(setq fx:brep (vla-Copy fx:fbox))
(vla-Move fx:brep (fx:p '(0.0 0.0 0.0)) (fx:p '(0.0 60.0 0.0)))
(command "_.BREP" (vlax-vla-object->ename fx:brep) "")
(fx:idle)
; One solid with two disconnected lumps is the native multi-body probe; do not edit SAT/SAB headers.
(command "_.BOX" "80,130,0" "100,150" "20")
(fx:idle)
(setq fx:multi (entlast))
(command "_.BOX" "115,130,0" "135,150" "20")
(fx:idle)
(setq fx:multi2 (entlast))
(command "_.UNION" fx:multi fx:multi2 "")
(fx:idle)
(setq fx:rgcurve (vla-AddCircle fx:ms (fx:p '(170.0 145.0 0.0)) 15.0))
(vla-AddRegion fx:ms (fx:a (list fx:rgcurve) 9))
(setq fx:sb (vla-Add (vla-get-Blocks fx:doc) (fx:p '(0.0 0.0 0.0)) "HDXF_ACIS"))
(vla-AddSphere fx:sb (fx:p '(0.0 0.0 8.0)) 8.0)
(vla-AddRegion fx:sb (fx:a (list (vla-AddCircle fx:sb (fx:p '(20.0 0.0 0.0)) 5.0)) 9))
(vla-InsertBlock fx:ms (fx:p '(220.0 145.0 0.0)) "HDXF_ACIS" 1.2 1.2 1.2 0.3)
(setq fx:pl (vla-Add (vla-get-Layouts fx:doc) "HDXF_SOLIDS"))
(setvar "TILEMODE" 0)
(setvar "CTAB" "HDXF_SOLIDS")
(vla-AddBox (vla-get-PaperSpace fx:doc) (fx:p '(30.0 30.0 8.0)) 20.0 15.0 16.0)
(setvar "TILEMODE" 1)
(fx:type "3DSOLID")
(fx:type "REGION")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_solids.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_solids_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(vla-Rotate3D fx:box (fx:p '(0.0 0.0 0.0)) (fx:p '(1.0 1.0 0.0)) 0.4)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_solids_solid_rotated.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_solids_solid_rotated_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 10_solids\n")
