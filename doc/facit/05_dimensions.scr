; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 05_dimensions.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Linear/aligned/angular 2-line and 3-point/radius/diameter/ordinate/arc/jogged dimensions; LEADER, QLEADER, text and block MLEADER + custom MLEADERSTYLE.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setvar "DIMASSOC" 2)
(setvar "DIMSCALE" 1.0)
(setvar "DIMTXT" 3.0)
(setvar "DIMASZ" 3.0)
(command "_.LINE" "0,0" "80,0" "80,50" "")
(fx:idle)
(command "_.DIMLINEAR" "0,0" "80,0" "40,-15")
(fx:idle)
(vla-AddDimAligned fx:ms (fx:p '(0.0 0.0 0.0)) (fx:p '(80.0 50.0 0.0)) (fx:p '(-15.0 40.0 0.0)))
(vla-AddDim3PointAngular fx:ms (fx:p '(100.0 0.0 0.0)) (fx:p '(125.0 0.0 0.0)) (fx:p '(115.0 25.0 0.0)) (fx:p '(135.0 20.0 0.0)))
(command "_.LINE" "160,0" "190,0" "")
(fx:idle)
(setq fx:angle1 (entlast))
(command "_.LINE" "160,0" "180,25" "")
(fx:idle)
(setq fx:angle2 (entlast))
(command "_.DIMANGULAR" (list fx:angle1 '(175.0 0.0 0.0)) (list fx:angle2 '(170.0 21.0 0.0)) "185,12")
(fx:idle)
(command "_.CIRCLE" "30,110" "20")
(fx:idle)
(setq fx:circle (entlast))
(command "_.DIMRADIUS" (list fx:circle '(50.0 110.0 0.0)) "65,125")
(fx:idle)
(command "_.DIMDIAMETER" (list fx:circle '(30.0 90.0 0.0)) "20,75")
(fx:idle)
(vla-AddDimOrdinate fx:ms (fx:p '(80.0 100.0 0.0)) (fx:p '(95.0 120.0 0.0)) 1)
(vla-AddDimOrdinate fx:ms (fx:p '(80.0 100.0 0.0)) (fx:p '(110.0 100.0 0.0)) 0)
(vla-AddDimArc fx:ms (fx:p '(150.0 110.0 0.0)) (fx:p '(170.0 110.0 0.0)) (fx:p '(150.0 130.0 0.0)) (fx:p '(175.0 135.0 0.0)))
(vla-AddDimRadialLarge fx:ms (fx:p '(220.0 110.0 0.0)) (fx:p '(270.0 110.0 0.0)) (fx:p '(235.0 110.0 0.0)) (fx:p '(245.0 120.0 0.0)) 0.7853981633974483)
(setq fx:note (vla-AddMText fx:ms (fx:p '(40.0 180.0 0.0)) 50.0 "Associative LEADER\\Pannotation"))
(vla-AddLeader fx:ms (fx:a '(0.0 150.0 0.0 20.0 180.0 0.0 40.0 180.0 0.0) 5) fx:note 1)
; QLEADER is configured explicitly through its ACAD_QLEADER settings XRECORD.
(setq fx:qd (dictsearch (namedobjdict) "ACAD_QLEADER"))
(if fx:qd (dictremove (namedobjdict) "ACAD_QLEADER"))
(dictadd (namedobjdict) "ACAD_QLEADER" (entmakex '((0 . "XRECORD") (100 . "AcDbXrecord") (280 . 1) (3 . "") (40 . 0.0) (60 . 0) (61 . 0) (62 . 0) (63 . 0) (64 . 0) (65 . 0) (66 . 0) (67 . 3) (68 . 0) (69 . 0) (70 . 0) (71 . 0) (72 . 0) (170 . 0))))
(command "_.QLEADER" "100,160" "120,185" "145,185" "0" "QLEADER note" "")
(fx:idle)
(setq fx:mldict (vla-Item (vla-get-Dictionaries fx:doc) "ACAD_MLEADERSTYLE"))
(setq fx:mls (vla-AddObject fx:mldict "HDXF_LEADER" "AcDbMLeaderStyle"))
(vla-put-TextHeight fx:mls 3.0)
(vla-put-ArrowSize fx:mls 3.5)
(vla-put-DoglegLength fx:mls 7.0)
(setq fx:ml (vla-AddMLeader fx:ms (fx:a '(180.0 160.0 0.0 200.0 185.0 0.0 225.0 185.0 0.0) 5) 0))
(vla-put-StyleName fx:ml "HDXF_LEADER")
(vla-put-TextString fx:ml "MLEADER\\Pformatted {\\C1;text}")
(setq fx:balloon (vla-Add (vla-get-Blocks fx:doc) (fx:p '(0.0 0.0 0.0)) "HDXF_BALLOON"))
(vla-AddCircle fx:balloon (fx:p '(0.0 0.0 0.0)) 4.0)
(vla-AddAttribute fx:balloon 3.0 0 "Number" (fx:p '(-1.0 -1.0 0.0)) "NUMBER" "7")
(setq fx:mb (vla-AddMLeader fx:ms (fx:a '(260.0 160.0 0.0 280.0 185.0 0.0) 5) 0))
(vla-put-ContentType fx:mb 1)
(vla-put-ContentBlockName fx:mb "HDXF_BALLOON")
(setq fx:dimblock (vla-Add (vla-get-Blocks fx:doc) (fx:p '(0.0 0.0 0.0)) "HDXF_SPECIAL_DIMS"))
(vla-AddDimArc fx:dimblock (fx:p '(0.0 0.0 0.0)) (fx:p '(20.0 0.0 0.0)) (fx:p '(0.0 20.0 0.0)) (fx:p '(25.0 25.0 0.0)))
(vla-AddDimRadialLarge fx:dimblock (fx:p '(60.0 0.0 0.0)) (fx:p '(110.0 0.0 0.0)) (fx:p '(75.0 0.0 0.0)) (fx:p '(85.0 10.0 0.0)) 0.7)
(vla-InsertBlock fx:ms (fx:p '(0.0 250.0 0.0)) "HDXF_SPECIAL_DIMS" 1.0 1.0 1.0 0.2)
(setq fx:dimlayout (vla-Add (vla-get-Layouts fx:doc) "HDXF_DIMENSIONS"))
(setvar "TILEMODE" 0)
(setvar "CTAB" "HDXF_DIMENSIONS")
(setq fx:dimps (vla-get-PaperSpace fx:doc))
(vla-AddDimArc fx:dimps (fx:p '(30.0 30.0 0.0)) (fx:p '(50.0 30.0 0.0)) (fx:p '(30.0 50.0 0.0)) (fx:p '(55.0 55.0 0.0)))
(vla-AddDimRadialLarge fx:dimps (fx:p '(100.0 30.0 0.0)) (fx:p '(150.0 30.0 0.0)) (fx:p '(115.0 30.0 0.0)) (fx:p '(125.0 40.0 0.0)) 0.7)
(setvar "TILEMODE" 1)
(fx:type "DIMENSION")
(fx:type "ARC_DIMENSION")
(fx:type "LARGE_RADIAL_DIMENSION")
(fx:type "LEADER")
(fx:type "MULTILEADER")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_dimensions.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_dimensions_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 05_dimensions\n")
