; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 16_dynamic_blocks.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Native Block Editor base/alignment/linear/rotation/flip parameters, stretch/rotate/flip actions and different dynamic INSERT values; no document change.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setq fx:db (vla-Add (vla-get-Blocks fx:doc) (fx:p '(0.0 0.0 0.0)) "HDXF_DYNAMIC"))
(vla-AddLine fx:db (fx:p '(0.0 0.0 0.0)) (fx:p '(40.0 0.0 0.0)))
(vla-AddLine fx:db (fx:p '(40.0 0.0 0.0)) (fx:p '(40.0 15.0 0.0)))
(vla-AddCircle fx:db (fx:p '(10.0 7.5 0.0)) 4.0)
(setvar "BACTIONBARMODE" 0)
(command "_.-BEDIT" "HDXF_DYNAMIC")
(fx:idle)
(command "_.ZOOM" "_Window" "-30,-30" "90,50")
(fx:idle)
(setq fx:geometry (ssget "_X" '((0 . "LINE,CIRCLE"))))
(command "_.BPARAMETER" "_Base" "0,0")
(fx:idle)
(command "_.BPARAMETER" "_Alignment" "0,0" "10,0")
(fx:idle)
(command "_.BPARAMETER" "_Linear" "_Label" "HDXF_Length" "0,0" "40,0" "20,-10" "1")
(fx:idle)
(command "_.BACTION" "20,-10" "_Stretch" "_Second" "30,-5" "45,20" fx:geometry "" "45,-15")
(fx:idle)
(command "_.BPARAMETER" "_Rotation" "_Label" "HDXF_Angle" "0,0" "30" "0" "30,-10" "1")
(fx:idle)
(fx:idle)
(command "_.BACTION" "0,30" fx:geometry "" "-15,25")
(fx:idle)
(command "_.BPARAMETER" "_Flip" "20,-5" "20,25" "25,25" "1")
(fx:idle)
(fx:idle)
(command "_.BACTION" "20,15" fx:geometry "" "30,30")
(fx:idle)
(command "_.BPARAMETER" "_Point" "_Label" "HDXF_position" "55,10" "55,22" "1")
(fx:idle)
(fx:idle)
(command "_.BACTION" "55,10" "_Move" fx:geometry "" "-15,15")
(fx:idle)
(command "_.BPARAMETER" "_Visibility" "60,25" "1")
(fx:idle)
(command "_.-BVSTATE" "_New" "HDXF_ALL" "_Show")
(fx:idle)
(command "_.-BVSTATE" "_New" "HDXF_HIDDEN" "_Hide")
(fx:idle)
(command "_.-BVSTATE" "_Set" "HDXF_ALL")
(fx:idle)
(command "_.BSAVE")
(fx:idle)
(command "_.BCLOSE")
(fx:idle)
(setq fx:dr1 (vla-InsertBlock fx:ms (fx:p '(0.0 0.0 0.0)) "HDXF_DYNAMIC" 1.0 1.0 1.0 0.0))
(setq fx:dr2 (vla-InsertBlock fx:ms (fx:p '(100.0 0.0 0.0)) "HDXF_DYNAMIC" 1.0 1.0 1.0 0.0))
(fx:need (= (vla-get-IsDynamicBlock fx:dr1) :vlax-true) "Block Editor did not create a dynamic block")
(defun fx:dynset (block property value / found) (foreach p (vlax-invoke block 'GetDynamicBlockProperties) (if (= (vla-get-PropertyName p) property) (progn (vla-put-Value p (vlax-make-variant value (vlax-variant-type (vla-get-Value p)))) (setq found T)))) (fx:need found (strcat "Missing dynamic property " property)))
(fx:dynset fx:dr2 "HDXF_Length" 65.0)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_dynamic_blocks.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_dynamic_blocks_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(fx:dynset fx:dr2 "HDXF_Angle" 0.5)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_dynamic_blocks_rotation_changed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_dynamic_blocks_rotation_changed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 16_dynamic_blocks\n")
