; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 04_blocks_attributes.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Nested blocks, INSERT/MINSERT, variable/constant/invisible/preset/locked and multiline ATTDEF/ATTRIB, transformed instances, XDATA/extension dictionary.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setq fx:blocks (vla-get-Blocks fx:doc) fx:b (vla-Add fx:blocks (fx:p '(0.0 0.0 0.0)) "HDXF_TAGGED"))
(vla-AddLine fx:b (fx:p '(0.0 0.0 0.0)) (fx:p '(40.0 20.0 0.0)))
(setq fx:att (vla-AddAttribute fx:b 3.0 0 "Part" (fx:p '(0.0 0.0 0.0)) "PART" "P-001"))
(vla-AddAttribute fx:b 3.0 2 "Constant" (fx:p '(0.0 -5.0 0.0)) "FIXED" "constant")
(vla-AddAttribute fx:b 3.0 1 "Hidden" (fx:p '(0.0 -10.0 0.0)) "HIDDEN" "invisible")
(vla-AddAttribute fx:b 3.0 8 "Preset" (fx:p '(0.0 -15.0 0.0)) "PRESET" "preset")
(setq fx:ma (vla-AddAttribute fx:b 3.0 32 "Multiline" (fx:p '(0.0 10.0 0.0)) "NOTES" "First line"))
(vla-put-MTextAttribute fx:ma :vlax-true)
(vla-put-MTextAttributeContent fx:ma "First line\\PSecond {\\C1;red} line\\PThird line")
(vla-put-MTextBoundaryWidth fx:ma 35.0)
(vla-put-LockPosition fx:ma :vlax-true)
(vla-UpdateMTextAttribute fx:ma)
(setq fx:i1 (vla-InsertBlock fx:ms (fx:p '(0.0 0.0 0.0)) "HDXF_TAGGED" 1.0 1.0 1.0 0.0))
(setq fx:i2 (vla-InsertBlock fx:ms (fx:p '(100.0 30.0 10.0)) "HDXF_TAGGED" 1.5 0.75 1.0 0.5))
(foreach a (vlax-invoke fx:i2 'GetAttributes) (if (= (vla-get-TagString a) "PART") (vla-put-TextString a "P-002")) (if (= (vla-get-TagString a) "NOTES") (progn (vla-put-MTextAttributeContent a "Other instance\\PScaled and rotated") (vla-UpdateMTextAttribute a))))
(vla-AddMInsertBlock fx:ms (fx:p '(0.0 80.0 0.0)) "HDXF_TAGGED" 1.0 1.0 1.0 0.1 2 3 35.0 50.0)
(setq fx:nest (vla-Add fx:blocks (fx:p '(0.0 0.0 0.0)) "HDXF_NESTED"))
(vla-InsertBlock fx:nest (fx:p '(10.0 5.0 0.0)) "HDXF_TAGGED" 0.5 0.5 0.5 0.2)
(vla-InsertBlock fx:ms (fx:p '(200.0 0.0 0.0)) "HDXF_NESTED" 2.0 2.0 2.0 -0.3)
(regapp "HDXF_FACIT")
(setq fx:be (tblobjname "BLOCK" "HDXF_TAGGED"))
(entmod (append (entget fx:be) '((-3 ("HDXF_FACIT" (1000 . "block-begin") (1070 . 12))))))
(setq fx:xd (vla-GetExtensionDictionary fx:i1) fx:xr (vla-AddXRecord fx:xd "HDXF_INSERT_INFO"))
(vla-SetXRecordData fx:xr (fx:a '(1 40 70) 2) (fx:a '("instance metadata" 12.5 7) 12))
(fx:type "INSERT")
(fx:need (> (length (vlax-invoke fx:i1 (quote GetAttributes))) 0) "Missing ATTRIB")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_blocks_attributes.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_blocks_attributes_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(foreach a (vlax-invoke fx:i1 'GetAttributes) (if (= (vla-get-TagString a) "PART") (vla-put-TextString a "P-003")))
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_blocks_attributes_attribute_changed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_blocks_attributes_attribute_changed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 04_blocks_attributes\n")
