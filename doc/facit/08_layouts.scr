; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 08_layouts.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Two paper layouts, model/paper geometry, standard/clipped viewports, per-viewport frozen layer, page setup/plot style and ACIS in paper/block.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setq fx:lay (vla-Add (vla-get-Layers fx:doc) "HDXF_VP_FROZEN"))
(vla-put-ActiveLayer fx:doc fx:lay)
(command "_.LINE" "0,0" "100,50" "")
(fx:idle)
(vla-put-ActiveLayer fx:doc (vla-Item (vla-get-Layers fx:doc) "0"))
(command "_.CIRCLE" "50,25" "20")
(fx:idle)
(setq fx:layoutA (vla-Add (vla-get-Layouts fx:doc) "HDXF_A") fx:layoutB (vla-Add (vla-get-Layouts fx:doc) "HDXF_B"))
(setvar "TILEMODE" 0)
(setvar "CTAB" "HDXF_A")
(command "_.PSPACE")
(fx:idle)
(setq fx:ps (vla-get-PaperSpace fx:doc))
(vla-AddLine fx:ps (fx:p '(0.0 0.0 0.0)) (fx:p '(260.0 180.0 0.0)))
(vla-AddText fx:ps "HDXF layout A" (fx:p '(10.0 185.0 0.0)) 4.0)
(setq fx:vp (vla-AddPViewport fx:ps (fx:p '(75.0 85.0 0.0)) 120.0 100.0))
(vla-Display fx:vp :vlax-true)
(command "_.REGEN")
(fx:idle)
(command "_.MSPACE")
(fx:idle)
(command "_.ZOOM" "_Extents")
(fx:idle)
(command "_.VPLAYER" "_Freeze" "HDXF_VP_FROZEN" "_Current" "")
(fx:idle)
(command "_.PSPACE")
(fx:idle)
(vla-put-DisplayLocked fx:vp :vlax-true)
(command "_.REGEN")
(fx:idle)
(command "_.MVIEW" "_Polygonal" "150,35" "250,35" "255,125" "200,145" "145,115" "_Close")
(fx:idle)
(setq fx:paperbox (vla-AddBox fx:ps (fx:p '(20.0 170.0 4.0)) 8.0 6.0 8.0))
(setvar "CTAB" "HDXF_B")
(vla-AddText (vla-get-PaperSpace fx:doc) "HDXF layout B" (fx:p '(10.0 185.0 0.0)) 4.0)
(setq fx:vp2 (vla-AddPViewport (vla-get-PaperSpace fx:doc) (fx:p '(130.0 95.0 0.0)) 240.0 160.0))
(vla-Display fx:vp2 :vlax-true)
(vla-put-DisplayLocked fx:vp2 :vlax-true)
(vla-put-PlotWithPlotStyles fx:layoutB :vlax-true)
(vla-put-PlotWithLineweights fx:layoutB :vlax-true)
(vla-put-StyleSheet fx:layoutB "monochrome.ctb")
(vla-put-PlotRotation fx:layoutB 1)
(vla-put-ShadePlot fx:vp2 3)
(setvar "CTAB" "HDXF_A")
(fx:type "VIEWPORT")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_layouts.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_layouts_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 08_layouts\n")
