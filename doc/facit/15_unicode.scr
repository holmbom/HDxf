; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 15_unicode.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Swedish/Japanese/Greek/Cyrillic text and symbol names, Unicode paths, supplementary Unicode via surrogate escapes, SHX/TrueType, long MTEXT and ATTRIB.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(fx:need (> (getvar "LISPSYS") 0) "15_unicode requires LISPSYS=1 or 2 and an AutoCAD restart before running")
(setq fx:sw (strcat "R" (chr 228) "ksm" (chr 246) "rg" (chr 229) "s " (chr 197) (chr 196) (chr 214)))
(setq fx:jp (strcat (chr 26085) (chr 26412) (chr 35486)))
(setq fx:gr (strcat (chr 913) (chr 955) (chr 966) (chr 945)))
(setq fx:ru (strcat (chr 1055) (chr 1088) (chr 1080) (chr 1074) (chr 1077) (chr 1090)))
(setq fx:lname (strcat "Lager_" (chr 229) (chr 228) (chr 246) "_" fx:jp))
(setq fx:ul (vla-Add (vla-get-Layers fx:doc) fx:lname))
(vla-put-ActiveLayer fx:doc fx:ul)
(fx:style "HDXF_UNICODE" "arial.ttf")
(setq fx:ut (vla-AddText fx:ms (strcat fx:sw " | " fx:jp " | " fx:gr " | " fx:ru) (fx:p '(0.0 0.0 0.0)) 4.0))
(vla-put-StyleName fx:ut "HDXF_UNICODE")
; ASCII .scr source; AutoCAD interprets the two UTF-16 surrogate escapes for each supplementary character.
(setq fx:um (vla-AddMText fx:ms (fx:p '(0.0 -15.0 0.0)) 180.0 (strcat fx:sw "\\P" fx:jp "\\PEmoji \\U+D83D\\U+DE00, music \\U+D834\\U+DD1E, CJK \\U+D840\\U+DC00\\PControls: tab\tand line\nfeed; %%d %%p %%c")))
(vla-put-StyleName fx:um "HDXF_UNICODE")
(setq fx:long "")
(repeat 40 (setq fx:long (strcat fx:long fx:sw " " fx:jp " ")))
(vla-AddMText fx:ms (fx:p '(0.0 -90.0 0.0)) 200.0 fx:long)
(setq fx:ub (vla-Add (vla-get-Blocks fx:doc) (fx:p '(0.0 0.0 0.0)) (strcat "Block_" fx:jp)))
(vla-AddAttribute fx:ub 3.0 0 "Unicode" (fx:p '(0.0 0.0 0.0)) "UNICODE" (strcat fx:sw " " fx:jp))
(vla-InsertBlock fx:ms (fx:p '(0.0 30.0 0.0)) (vla-get-Name fx:ub) 1.0 1.0 1.0 0.1)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_unicode.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_unicode_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 15_unicode\n")
