; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 13_objects.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; GROUP, custom MLINESTYLE/MLINE, nested dictionary/XRECORD, entity extension data, DRAWORDER, block XCLIP, LIGHT/SUN, MATERIAL/VISUALSTYLE and two section planes.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setq fx:o1 (vla-AddCircle fx:ms (fx:p '(20.0 20.0 0.0)) 15.0) fx:o2 (vla-AddLine fx:ms (fx:p '(0.0 0.0 0.0)) (fx:p '(60.0 40.0 0.0))))
(setq fx:group (vla-Add (vla-get-Groups fx:doc) "HDXF_GROUP"))
(vla-AppendItems fx:group (fx:a (list fx:o1 fx:o2) 9))
(setq fx:dict (vla-Add (vla-get-Dictionaries fx:doc) "HDXF_DICTIONARY") fx:child (vla-AddObject fx:dict "CHILD" "AcDbDictionary"))
(setq fx:xr (vla-AddXRecord fx:child "VALUES"))
(vla-SetXRecordData fx:xr (fx:a '(1 40 70 90 10) 2) (fx:a (list "Native XRECORD" 12.75 23 123456 (fx:p '(1.0 2.0 3.0))) 12))
(setq fx:ext (vla-GetExtensionDictionary fx:o1) fx:er (vla-AddXRecord fx:ext "HDXF_META"))
(vla-SetXRecordData fx:er (fx:a '(1 40) 2) (fx:a '("entity extension" 9.5) 12))
(setq fx:md (cdr (assoc -1 (dictsearch (namedobjdict) "ACAD_MLINESTYLE"))))
(fx:need fx:md "ACAD_MLINESTYLE dictionary missing from acad.dwt")
(setq fx:mstyle (entmakex '((0 . "MLINESTYLE") (100 . "AcDbMlineStyle") (2 . "HDXF_MLINE") (70 . 273) (3 . "Three parallel lines with caps and fill") (62 . 2) (51 . 1.5707963267948966) (52 . 1.5707963267948966) (71 . 3) (49 . 1.0) (62 . 1) (6 . "BYLAYER") (49 . 0.0) (62 . 3) (6 . "BYLAYER") (49 . -1.0) (62 . 5) (6 . "BYLAYER"))))
(fx:need (dictadd fx:md "HDXF_MLINE" fx:mstyle) "MLINESTYLE creation failed")
(command "_.MLINE" "_Style" "HDXF_MLINE" "_Scale" "3" "_Justification" "_Zero" "0,80" "50,80" "60,110" "90,110" "")
(fx:idle)
(command "_.DRAWORDER" (vlax-vla-object->ename fx:o1) "" "_Back")
(fx:idle)
(setq fx:cb (vla-Add (vla-get-Blocks fx:doc) (fx:p '(0.0 0.0 0.0)) "HDXF_CLIPPED"))
(vla-AddCircle fx:cb (fx:p '(20.0 20.0 0.0)) 25.0)
(vla-AddLine fx:cb (fx:p '(-20.0 0.0 0.0)) (fx:p '(70.0 50.0 0.0)))
(setq fx:ci (vla-InsertBlock fx:ms (fx:p '(120.0 0.0 0.0)) "HDXF_CLIPPED" 1.0 1.0 1.0 0.0))
(command "_.XCLIP" (vlax-vla-object->ename fx:ci) "" "_New" "_Polygonal" "125,5" "160,5" "165,35" "130,45" "")
(fx:idle)
(setvar "LIGHTINGUNITS" 2)
(setvar "DEFAULTLIGHTING" 0)
(command "_.POINTLIGHT" "30,30,80" "_Name" "HDXF_POINT" "_Intensity" "1.5" "")
(fx:idle)
(command "_.SPOTLIGHT" "100,20,90" "40,40,0" "_Name" "HDXF_SPOT" "")
(fx:idle)
(setvar "SUNSTATUS" 1)
(setvar "LATITUDE" 59.3293)
(setvar "LONGITUDE" 18.0686)
(setvar "NORTHDIRECTION" 0.2)
(setq fx:mat (vla-Add (vla-get-Materials fx:doc) "HDXF_MATERIAL"))
(vla-put-Description fx:mat "Native material applied to the sectioned box")
(setq fx:solid (vla-AddBox fx:ms (fx:p '(70.0 160.0 20.0)) 60.0 40.0 40.0))
(vla-put-Material fx:solid "HDXF_MATERIAL")
(command "_.-VISUALSTYLES" "_Current" "Conceptual")
(fx:idle)
(command "_.-VISUALSTYLES" "_Saveas" "HDXF_VISUAL")
(fx:idle)
(setq fx:sec (vla-AddSection fx:ms (fx:p '(20.0 160.0 0.0)) (fx:p '(120.0 160.0 0.0)) (fx:p '(0.0 0.0 1.0))))
(vla-put-Name fx:sec "HDXF_SECTION_A")
(vla-put-TopHeight fx:sec 60.0)
(vla-put-BottomHeight fx:sec 5.0)
(vla-put-IndicatorTransparency fx:sec 35)
(vla-CreateJog fx:sec (fx:p '(70.0 160.0 0.0)))
(setq fx:sec2 (vla-AddSection fx:ms (fx:p '(70.0 120.0 0.0)) (fx:p '(70.0 200.0 0.0)) (fx:p '(0.0 0.0 1.0))))
(vla-put-Name fx:sec2 "HDXF_SECTION_B")
(fx:type "MLINE")
(fx:type "LIGHT")
(fx:type "SECTIONOBJECT")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_objects.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_objects_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(vla-RemoveItems fx:group (fx:a (list fx:o2) 9))
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_objects_group_member_removed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_objects_group_member_removed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(vla-put-TopHeight fx:sec 75.0)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_objects_section_changed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_objects_section_changed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 13_objects\n")
