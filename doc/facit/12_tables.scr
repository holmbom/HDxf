; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 12_tables.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; TABLE/TABLESTYLE, merged cells, strings/numbers/formula/block content, cell borders/fill, FIELD in MTEXT and TABLE, FIELD dictionary graph.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setq fx:td (vla-Item (vla-get-Dictionaries fx:doc) "ACAD_TABLESTYLE"))
(setq fx:ts (vla-AddObject fx:td "HDXF_TABLE" "AcDbTableStyle"))
(vla-put-Description fx:ts "HDxf native table style")
(vla-put-HorzCellMargin fx:ts 1.5)
(vla-put-VertCellMargin fx:ts 1.0)
(vla-SetTextHeight fx:ts 1 3.0)
(vla-SetTextHeight fx:ts 2 5.0)
(vla-SetTextHeight fx:ts 4 3.5)
(setq fx:table (vla-AddTable fx:ms (fx:p '(0.0 80.0 0.0)) 7 4 10.0 35.0))
(vla-put-StyleName fx:table "HDXF_TABLE")
(vla-SetText fx:table 0 0 "HDxf TABLE and FIELD")
(vla-SetText fx:table 1 0 "Item")
(vla-SetText fx:table 1 1 "Count")
(vla-SetText fx:table 1 2 "Length")
(vla-SetText fx:table 1 3 "Value / field")
(vla-SetText fx:table 2 0 "Member A")
(vla-SetText fx:table 2 1 "3")
(vla-SetText fx:table 2 2 "12.75")
(vla-SetText fx:table 3 0 "Member B")
(vla-SetText fx:table 3 1 "7")
(vla-SetText fx:table 3 2 "8.25")
(vla-SetCellDataType fx:table 2 1 1 0)
(vla-SetCellDataType fx:table 2 2 2 1)
(vla-SetFormula fx:table 4 2 0 "=SUM(C3:C4)")
(vla-MergeCells fx:table 5 5 0 2)
(vla-SetText fx:table 5 0 "Merged cells with background")
(setq fx:tc (vla-get-TrueColor fx:table))
(vla-SetRGB fx:tc 210 230 250)
(vla-SetCellBackgroundColor fx:table 5 0 fx:tc)
(vla-SetCellGridLineWeight fx:table 2 0 63 35)
(vla-SetCustomData fx:table 2 0 "HDXF_COST" (vlax-make-variant 12.75 5))
(setq fx:ci0 (vla-CreateContent fx:table 3 3 0))
(vla-SetTextString fx:table 3 3 fx:ci0 "First content")
(setq fx:ci1 (vla-CreateContent fx:table 3 3 1))
(vla-SetTextString fx:table 3 3 fx:ci1 "Second content in one cell")
(setq fx:tb (vla-Add (vla-get-Blocks fx:doc) (fx:p '(0.0 0.0 0.0)) "HDXF_TABLE_SYMBOL"))
(vla-AddCircle fx:tb (fx:p '(0.0 0.0 0.0)) 2.0)
(vla-SetBlockTableRecordId fx:table 6 0 (vla-get-ObjectID fx:tb) :vlax-true)
(setq fx:fieldline (vla-AddLine fx:ms (fx:p '(0.0 -20.0 0.0)) (fx:p '(100.0 -20.0 0.0))))
(setq fx:id (vla-GetObjectIdString (vla-get-Utility fx:doc) fx:fieldline :vlax-false))
(setq fx:field (strcat "%<\\AcObjProp Object(%<\\_ObjId " fx:id ">%).Length \\f \"%lu2%pr3\">%"))
(vla-AddMText fx:ms (fx:p '(0.0 -35.0 0.0)) 150.0 (strcat "Length = " fx:field "\\PFile = %<\\AcVar Filename \\f \"%fn6\">%"))
(vla-SetText fx:table 2 3 fx:field)
(vla-SetText fx:table 3 3 "%<\\AcExpr (2.5+7.25) \\f \"%lu2%pr2\">%")
(command "_.UPDATEFIELD" "_All" "")
(fx:idle)
(vla-RecomputeTableBlock fx:table :vlax-true)
(fx:type "ACAD_TABLE")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_tables.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_tables_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(vla-SetText fx:table 2 1 "9")
(vla-RecomputeTableBlock fx:table :vlax-true)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_tables_cell_changed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_tables_cell_changed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(vla-put-EndPoint fx:fieldline (fx:p '(125.0 -20.0 0.0)))
(command "_.UPDATEFIELD" "_All" "")
(fx:idle)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_tables_field_target_changed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_tables_field_target_changed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 12_tables\n")
