; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 02_basic.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; R12 primitives, all legacy polylines, LWPOLYLINE, rational/control and fit SPLINE, ELLIPSE, XLINE, RAY, optional shipped SHAPE.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(command "_.LINE" "0,0,0" "100,50,20" "")
(fx:idle)
(command "_.CIRCLE" "30,60,0" "12")
(fx:idle)
(command "_.ARC" "60,60" "80,80" "100,60")
(fx:idle)
(command "_.POINT" "110,60,5")
(fx:idle)
(fx:e '((0 . "TRACE") (8 . "0") (10 0.0 90.0 0.0) (11 25.0 90.0 0.0) (12 0.0 105.0 0.0) (13 25.0 105.0 0.0)))
(fx:e '((0 . "SOLID") (8 . "0") (10 35.0 90.0 0.0) (11 60.0 90.0 0.0) (12 35.0 105.0 0.0) (13 60.0 105.0 0.0)))
(fx:e '((0 . "3DFACE") (8 . "0") (10 70.0 90.0 0.0) (11 95.0 90.0 5.0) (12 95.0 110.0 15.0) (13 70.0 110.0 5.0) (70 . 1)))
; Legacy 2D POLYLINE with widths/bulge and vertex XDATA.
(regapp "HDXF_FACIT")
(fx:e '((0 . "POLYLINE") (66 . 1) (10 0.0 0.0 0.0) (70 . 1) (40 . 1.0) (41 . 2.0)))
(fx:e '((0 . "VERTEX") (10 0.0 130.0 0.0) (40 . 1.0) (41 . 3.0) (42 . 0.5) (-3 ("HDXF_FACIT" (1000 . "vertex") (1070 . 7)))))
(fx:e '((0 . "VERTEX") (10 40.0 130.0 0.0) (42 . -0.25)))
(fx:e '((0 . "VERTEX") (10 40.0 155.0 0.0)))
(fx:e '((0 . "SEQEND")))
(fx:e '((0 . "POLYLINE") (66 . 1) (10 0.0 0.0 0.0) (70 . 8)))
(foreach p '((60.0 130.0 0.0) (80.0 150.0 20.0) (100.0 130.0 40.0)) (fx:e (list '(0 . "VERTEX") (cons 10 p) '(70 . 32))))
(fx:e '((0 . "SEQEND")))
(fx:e '((0 . "POLYLINE") (66 . 1) (10 0.0 0.0 0.0) (70 . 16) (71 . 2) (72 . 3)))
(foreach p '((0.0 180.0 0.0) (20.0 180.0 5.0) (40.0 180.0 0.0) (0.0 200.0 5.0) (20.0 200.0 15.0) (40.0 200.0 5.0)) (fx:e (list '(0 . "VERTEX") (cons 10 p) '(70 . 64))))
(fx:e '((0 . "SEQEND")))
(fx:e '((0 . "POLYLINE") (66 . 1) (10 0.0 0.0 0.0) (70 . 64) (71 . 4) (72 . 2)))
(foreach p '((60.0 180.0 0.0) (85.0 180.0 0.0) (85.0 205.0 15.0) (60.0 205.0 5.0)) (fx:e (list '(0 . "VERTEX") (cons 10 p) '(70 . 192))))
(fx:e '((0 . "VERTEX") (10 0.0 0.0 0.0) (70 . 128) (71 . 1) (72 . 2) (73 . 3)))
(fx:e '((0 . "VERTEX") (10 0.0 0.0 0.0) (70 . 128) (71 . -1) (72 . 3) (73 . 4)))
(fx:e '((0 . "SEQEND")))
(fx:e '((0 . "LWPOLYLINE") (100 . "AcDbEntity") (100 . "AcDbPolyline") (90 . 3) (70 . 1) (10 120.0 0.0) (40 . 1.0) (41 . 3.0) (42 . 0.5) (10 160.0 0.0) (40 . 3.0) (41 . 1.0) (42 . -0.5) (10 160.0 35.0)))
(vla-AddEllipse fx:ms (fx:p '(145.0 65.0 0.0)) (fx:p '(25.0 8.0 0.0)) 0.4)
(setvar "SPLMETHOD" 0)
(command "_.SPLINE" "120,100" "140,115" "160,95" "180,120" "" "" "")
(fx:idle)
(fx:e '((0 . "SPLINE") (100 . "AcDbEntity") (100 . "AcDbSpline") (70 . 12) (71 . 3) (72 . 8) (73 . 4) (74 . 0) (40 . 0.0) (40 . 0.0) (40 . 0.0) (40 . 0.0) (40 . 1.0) (40 . 1.0) (40 . 1.0) (40 . 1.0) (41 . 1.0) (41 . 0.6) (41 . 1.4) (41 . 1.0) (10 120.0 150.0 0.0) (10 135.0 180.0 0.0) (10 160.0 140.0 0.0) (10 180.0 165.0 0.0)))
(vla-AddXLine fx:ms (fx:p '(220.0 0.0 0.0)) (fx:p '(220.0 10.0 0.0)))
(vla-AddRay fx:ms (fx:p '(230.0 0.0 0.0)) (fx:p '(240.0 10.0 0.0)))
; ltypeshp.shx and BAT ship with full AutoCAD; do not substitute a text font for a shape file.
(if (findfile "ltypeshp.shx") (progn (command "_.LOAD" (findfile "ltypeshp.shx")) (fx:idle) (vla-AddShape fx:ms "BAT" (fx:p '(200.0 190.0 0.0)) 10.0 0.3)) (princ "\nRESOURCE MISSING: ltypeshp.shx; SHAPE omitted.\n"))
(foreach name '("LINE" "CIRCLE" "ARC" "POINT" "TRACE" "SOLID" "3DFACE" "POLYLINE" "LWPOLYLINE" "ELLIPSE" "SPLINE" "XLINE" "RAY") (fx:type name))
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_basic.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_basic_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 02_basic\n")
