; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 17_associative.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Native 2D geometric/dimensional constraints, true DIMASSOC endpoint snaps, associative rectangular/polar/path arrays, vertex IDs and source edit snapshot.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setvar "CONSTRAINTINFER" 0)
(command "_.ZOOM" "_Window" "-20,-30" "280,230")
(fx:idle)
(setvar "DIMASSOC" 2)
(setvar "ARRAYASSOCIATIVITY" 1)
(command "_.LINE" "0,0" "80,0" "")
(fx:idle)
(setq fx:cline (entlast))
(command "_.GCHORIZONTAL" "_2Points" "_Endpoint" "0,0" "_Endpoint" "80,0")
(fx:idle)
(command "_.DCLINEAR" "_Endpoint" "0,0" "_Endpoint" "80,0" "40,-20" "80")
(fx:idle)
(command "_.LINE" "0,50" "80,50" "")
(fx:idle)
(setq fx:dline (vlax-ename->vla-object (entlast)))
; Explicit END object snaps create actual DIMASSOC references rather than coincident free points.
(command "_.DIMLINEAR" "_Endpoint" "0,50" "_Endpoint" "80,50" "40,70")
(fx:idle)
(setq fx:ac (vla-AddCircle fx:ms (fx:p '(10.0 120.0 0.0)) 4.0))
(command "_.ARRAYRECT" (vlax-vla-object->ename fx:ac) "" "3" "20" "_Rows" "2" "25" "0" "_Exit")
(fx:idle)
(setq fx:pc (vla-AddCircle fx:ms (fx:p '(120.0 120.0 0.0)) 4.0))
(command "_.ARRAYPOLAR" (vlax-vla-object->ename fx:pc) "" "100,120" "5" "300" "_Exit")
(fx:idle)
(setq fx:pa (vla-AddCircle fx:ms (fx:p '(0.0 200.0 0.0)) 3.0) fx:path (vla-AddSpline fx:ms (fx:a '(0.0 200.0 0.0 60.0 220.0 0.0 120.0 190.0 0.0) 5) (fx:p '(1.0 0.0 0.0)) (fx:p '(1.0 0.0 0.0))))
(command "_.ARRAYPATH" (vlax-vla-object->ename fx:pa) "" (vlax-vla-object->ename fx:path) "6" "_Divide" "_Exit")
(fx:idle)
; A constrained polyline lets AutoCAD assign vertex IDs; do not manufacture flag 1024.
(setq fx:vpoly (fx:rect 180.0 0.0 70.0 35.0))
(command "_.GCFIX" "_Endpoint" "180,0")
(fx:idle)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_associative.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_associative_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(vla-put-EndPoint fx:dline (fx:p '(105.0 50.0 0.0)))
(command "_.REGENALL")
(fx:idle)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_associative_endpoint_changed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_associative_endpoint_changed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 17_associative\n")
