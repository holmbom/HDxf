; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 14_annotative.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; Native annotative TEXT/MTEXT/dimensions/hatch/tolerance/MLEADER and attributed block, context scales 1:1, 1:2 and 1:5; scale removal snapshot.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(setvar "ANNOAUTOSCALE" 0)
(setvar "ANNOALLVISIBLE" 1)
(setvar "CANNOSCALE" "1:1")
(command "_.-SCALELISTEDIT" "_Add" "HDXF_1_2" "1:2" "_Exit")
(fx:idle)
(command "_.-SCALELISTEDIT" "_Add" "HDXF_1_5" "1:5" "_Exit")
(fx:idle)
(fx:e '((0 . "TEXT") (10 0.0 0.0 0.0) (40 . 3.0) (1 . "Annotative TEXT")))
(vla-AddMText fx:ms (fx:p '(0.0 20.0 0.0)) 60.0 "Annotative MTEXT\\PThree contexts")
(command "_.DIMLINEAR" "0,0" "80,0" "40,-20")
(fx:idle)
(vla-AddDimAligned fx:ms (fx:p '(100.0 0.0 0.0)) (fx:p '(140.0 30.0 0.0)) (fx:p '(110.0 40.0 0.0)))
(vla-AddDim3PointAngular fx:ms (fx:p '(170.0 0.0 0.0)) (fx:p '(200.0 0.0 0.0)) (fx:p '(185.0 25.0 0.0)) (fx:p '(200.0 25.0 0.0)))
(vla-AddDimRadial fx:ms (fx:p '(30.0 90.0 0.0)) (fx:p '(45.0 90.0 0.0)) 10.0)
(vla-AddDimDiametric fx:ms (fx:p '(70.0 75.0 0.0)) (fx:p '(70.0 105.0 0.0)) 10.0)
(vla-AddDimOrdinate fx:ms (fx:p '(110.0 90.0 0.0)) (fx:p '(125.0 110.0 0.0)) 1)
(vla-AddDimRadialLarge fx:ms (fx:p '(170.0 90.0 0.0)) (fx:p '(220.0 90.0 0.0)) (fx:p '(185.0 90.0 0.0)) (fx:p '(195.0 100.0 0.0)) 0.7)
(vla-AddTolerance fx:ms "{\\Fgdt;j}%%v0.05%%vA" (fx:p '(0.0 145.0 0.0)) (fx:p '(1.0 0.0 0.0)))
(setq fx:anote (vla-AddMText fx:ms (fx:p '(80.0 155.0 0.0)) 40.0 "Annotative LEADER"))
(vla-AddLeader fx:ms (fx:a '(40.0 130.0 0.0 60.0 155.0 0.0 80.0 155.0 0.0) 5) fx:anote 1)
(setq fx:aml (vla-AddMLeader fx:ms (fx:a '(130.0 140.0 0.0 155.0 160.0 0.0) 5) 0))
(vla-put-TextString fx:aml "Annotative MLEADER")
(setvar "HPANNOTATIVE" 1)
(setq fx:ab (fx:rect 0.0 190.0 50.0 30.0))
(command "_.-HATCH" "_Properties" "ANSI31" "2" "0" "_Select" (vlax-vla-object->ename fx:ab) "" "")
(fx:idle)
(setq fx:anncircle (vla-AddCircle fx:ms (fx:p '(0.0 0.0 0.0)) 5.0))
(setq fx:aat (vla-AddAttribute fx:ms 3.0 32 "Annotation" (fx:p '(0.0 8.0 0.0)) "ANNO_NOTES" "First line"))
(vla-put-MTextAttribute fx:aat :vlax-true)
(vla-put-MTextAttributeContent fx:aat "First\\PSecond")
(vla-UpdateMTextAttribute fx:aat)
(command "_.-BLOCK" "HDXF_ANNO_BLOCK" "_Annotative" "_Yes" "_No" "0,0,0" (vlax-vla-object->ename fx:anncircle) (vlax-vla-object->ename fx:aat) "")
(fx:idle)
(setq fx:annref (vla-InsertBlock fx:ms (fx:p '(90.0 205.0 0.0)) "HDXF_ANNO_BLOCK" 1.0 1.0 1.0 0.0))
; Annotative property is set through the native property interface, not hand-built context XRECORDs.
(setq fx:annsel (ssget "_X" '((0 . "TEXT,MTEXT,DIMENSION,ARC_DIMENSION,LARGE_RADIAL_DIMENSION,TOLERANCE,LEADER,MULTILEADER,HATCH"))))
(setq fx:k 0)
(repeat (sslength fx:annsel) (setpropertyvalue (ssname fx:annsel fx:k) "Annotative" 1) (setq fx:k (1+ fx:k)))
(ssadd (vlax-vla-object->ename fx:annref) fx:annsel)
(command "_.-OBJECTSCALE" fx:annsel "" "_Add" "HDXF_1_2" "")
(fx:idle)
(command "_.-OBJECTSCALE" fx:annsel "" "_Add" "HDXF_1_5" "")
(fx:idle)
(setvar "CANNOSCALE" "HDXF_1_2")
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_annotative.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_annotative_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(command "_.-OBJECTSCALE" fx:annsel "" "_Delete" "HDXF_1_5" "")
(fx:idle)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_annotative_scale_removed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_annotative_scale_removed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; ---- Run 2026-10-25 (plan F10): the files are in doc/facit; the rule is in doc/facit/testresultat.md.
; ---- Extra section (TABLE 70 counters): each table record is added alone, saved, removed alone, saved - in all seven versions, ASCII precision 16 + binary (R12 was the first run; 2000-2018 added so the 2000+ counters have AutoCAD facit too).
(defun fx:saveall (suffix / pair v kind path) (foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair)) (foreach kind '("" "_bin") (setq path (strcat fx:base "acad_" (car pair) "_dxf_annotative_scale_removed_" suffix kind ".dxf")) (if (= kind "") (command "_.SAVEAS" "DXF" "_V" v "16" path) (command "_.SAVEAS" "DXF" "_V" v "_B" path)) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))))
; VIEW: one plain named model-space view, centre (0,0), height 100, width 200, direction (0,0,1), target (0,0,0)
(setq fx:view (vla-Add (vla-get-Views fx:doc) "HDXF_F10_VIEW"))
(vla-put-Center fx:view (fx:a '(0.0 0.0) 5))
(vla-put-Height fx:view 100.0)
(vla-put-Width fx:view 200.0)
(vla-put-Direction fx:view (fx:a '(0.0 0.0 1.0) 5))
(vla-put-Target fx:view (fx:a '(0.0 0.0 0.0) 5))
(fx:need (tblsearch "VIEW" "HDXF_F10_VIEW") "View not created")
(fx:saveall "view_added")
(vla-Delete fx:view)
(fx:need (not (tblsearch "VIEW" "HDXF_F10_VIEW")) "View not deleted")
(fx:saveall "view_removed")
; STYLE: one text style, font txt
(setq fx:tstyle (vla-Add (vla-get-TextStyles fx:doc) "HDXF_F10_STYLE"))
(vla-put-FontFile fx:tstyle "txt")
(fx:need (tblsearch "STYLE" "HDXF_F10_STYLE") "Text style not created")
(fx:saveall "style_added")
(vla-Delete fx:tstyle)
(fx:need (not (tblsearch "STYLE" "HDXF_F10_STYLE")) "Text style not deleted")
(fx:saveall "style_removed")
; LTYPE: one linetype made with entmake (dash 10, gap 5)
(fx:need (entmake '((0 . "LTYPE") (100 . "AcDbSymbolTableRecord") (100 . "AcDbLinetypeTableRecord") (2 . "HDXF_F10_LTYPE") (70 . 0) (3 . "HDXF F10 dashed") (72 . 65) (73 . 2) (40 . 15.0) (49 . 10.0) (74 . 0) (49 . -5.0) (74 . 0))) "Linetype not created")
(fx:saveall "ltype_added")
(vla-Delete (vla-Item (vla-get-Linetypes fx:doc) "HDXF_F10_LTYPE"))
(fx:need (not (tblsearch "LTYPE" "HDXF_F10_LTYPE")) "Linetype not deleted")
(fx:saveall "ltype_removed")
; ---- End of extra section
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 14_annotative\n")
