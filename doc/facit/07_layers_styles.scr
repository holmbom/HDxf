; Open a NEW EMPTY drawing from acad.dwt (Ctrl+N) BEFORE running 07_layers_styles.scr; do not run NEW/OPEN in SCRIPT.
; AutoCAD 2025 GUI: SCRIPT or drag this file into the drawing window.
; ACI/RGB/transparency/lineweights/plotstyle layers, simple/complex upright linetypes, DIMSTYLE/TEXTSTYLE variants, UCS/VIEW/VPORT and XDATA.
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(vl-load-com)
(setq fx:doc (vla-get-ActiveDocument (vlax-get-acad-object)) fx:ms (vla-get-ModelSpace fx:doc) fx:base "C:/HDxf/doc/facit/")
(defun fx:need (ok message) (if (not ok) (progn (setvar "FILEDIA" 1) (setvar "CMDDIA" 1) (princ (strcat "\nFEL: " message "\n")) (exit))))
(defun fx:idle () (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (progn (command) (fx:need nil "Command did not finish; stop this script and inspect F2."))))
(defun fx:a (values kind / a) (setq a (vlax-make-safearray kind (cons 0 (1- (length values))))) (vlax-safearray-fill a values) (vlax-make-variant a))
(defun fx:p (point) (vlax-3d-point point))
(defun fx:e (data) (fx:need (entmake data) "entmake rejected an entity; inspect F2.") (entlast))
(defun fx:put (e code value / data old) (setq data (entget e) old (assoc code data)) (fx:need (entmod (if old (subst (cons code value) old data) (append data (list (cons code value))))) "entmod rejected a property") (entupd e) e)
(defun fx:field (e subclass code occurrence value / active n data out found) (setq n 0 data (entget e)) (foreach g data (if (= (car g) 100) (setq active (= (cdr g) subclass))) (if (and active (= (car g) code)) (progn (if (= n occurrence) (setq g (cons code value) found T)) (setq n (1+ n)))) (setq out (cons g out))) (fx:need found (strcat "Native field absent: " subclass "/" (itoa code))) (fx:need (entmod (reverse out)) "Native object rejected property edit") e)
(defun fx:type (name) (fx:need (ssget "_X" (list (cons 0 name))) (strcat "Missing entity type " name)))
(defun fx:rect (x y w h / o) (setq o (vla-AddLightWeightPolyline fx:ms (fx:a (list x y (+ x w) y (+ x w) (+ y h) x (+ y h)) 5))) (vla-put-Closed o :vlax-true) o)
(defun fx:style (name font / s) (setq s (vla-Add (vla-get-TextStyles fx:doc) name)) (if (wcmatch (strcase font) "*.TTF") (vla-SetFont s "Arial" :vlax-false :vlax-false 0 34) (vla-put-FontFile s font)) s)
(setvar "CMDECHO" 1)
(setvar "OSMODE" 0)
(setvar "3DOSMODE" 0)
(setvar "DYNMODE" 0)
(setvar "ORTHOMODE" 0)
(setvar "SNAPMODE" 0)
(setvar "UCSFOLLOW" 0)
(setvar "TILEMODE" 1)
(setvar "PROXYGRAPHICS" 1)
(setvar "THUMBSAVE" 1)
(setvar "ATTDIA" 0)
(setvar "ATTREQ" 0)
(setvar "DELOBJ" 0)
(command "_.UCS" "_World")
(fx:idle)
(fx:style "HDXF_SHX" "simplex.shx")
(setq fx:tt (fx:style "HDXF_ARIAL" "arial.ttf"))
(vla-SetFont fx:tt "Arial" :vlax-true :vlax-false 0 34)
(setq fx:layers (vla-get-Layers fx:doc) fx:l1 (vla-Add fx:layers "HDXF_ACI") fx:l2 (vla-Add fx:layers "HDXF_RGB") fx:l3 (vla-Add fx:layers "HDXF_NOPLOT"))
(vla-put-Color fx:l1 3)
(vla-put-Lineweight fx:l1 35)
(vla-put-Plottable fx:l3 :vlax-false)
(setq fx:rgb (vla-get-TrueColor fx:l2))
(vla-SetRGB fx:rgb 17 130 220)
(vla-put-TrueColor fx:l2 fx:rgb)
(command "_.-LAYER" "_Transparency" "45" "HDXF_RGB" "")
(fx:idle)
; Optional installed color books: attempt only actual book/color entries, never invent a book record.
(defun fx:split (s / n result) (while (setq n (vl-string-search ";" s)) (setq result (cons (substr s 1 n) result) s (substr s (+ n 2)))) (reverse (cons s result)))
(defun fx:xml (s tag / first last) (if (and (setq first (vl-string-search (strcat "<" tag ">") s)) (setq last (vl-string-search (strcat "</" tag ">") s))) (substr s (+ first (strlen tag) 3) (- last first (strlen tag) 2))))
(setq fx:bookok nil)
(foreach folder (fx:split (vla-get-ColorBookPath (vla-get-Files (vla-get-Preferences (vlax-get-acad-object))))) (foreach file (vl-directory-files folder "*.acb" 1) (if (and (not fx:bookok) (setq fx:f (open (strcat folder "/" file) "r"))) (progn (setq fx:xmltext "") (while (setq fx:line (read-line fx:f)) (setq fx:xmltext (strcat fx:xmltext fx:line))) (close fx:f) (setq fx:book (fx:xml fx:xmltext "bookName") fx:entry (fx:xml fx:xmltext "colorName")) (if (and fx:book fx:entry) (progn (setq fx:result (vl-catch-all-apply 'vla-SetColorBookColor (list fx:rgb fx:book fx:entry))) (if (not (vl-catch-all-error-p fx:result)) (progn (setq fx:booklayer (vla-Add fx:layers "HDXF_COLORBOOK")) (vla-put-TrueColor fx:booklayer fx:rgb) (setq fx:bookok T)))))))))
(if (not fx:bookok) (princ "\nRESOURCE MISSING: no readable installed color book; color-book layer omitted.\n"))
(vla-Load (vla-get-Linetypes fx:doc) "DASHED" "acad.lin")
(vla-Load (vla-get-Linetypes fx:doc) "GAS_LINE" "acad.lin")
(vla-put-Linetype fx:l1 "DASHED")
(setq fx:gas (vla-Item (vla-get-Linetypes fx:doc) "GAS_LINE"))
; AutoCAD's complex GAS_LINE contains the text style link and upright flag, not a synthetic dash list.
(vla-put-ActiveLayer fx:doc fx:l1)
(command "_.LINE" "0,0" "150,0" "")
(fx:idle)
(setq fx:line (vlax-ename->vla-object (entlast)))
(vla-put-Linetype fx:line "GAS_LINE")
(vla-put-LinetypeScale fx:line 2.0)
(vla-put-EntityTransparency fx:line "30")
(vla-put-ActiveLayer fx:doc fx:l2)
(command "_.CIRCLE" "40,30" "15")
(fx:idle)
(vla-put-ActiveLayer fx:doc (vla-Item fx:layers "0"))
(setvar "DIMLUNIT" 2)
(setvar "DIMATFIT" 3)
(setvar "DIMTXT" 3.0)
(setvar "DIMASZ" 3.5)
(setvar "DIMTXSTY" "HDXF_ARIAL")
(command "_.-DIMSTYLE" "_Save" "HDXF_DECIMAL")
(fx:idle)
(setvar "DIMLUNIT" 4)
(setvar "DIMATFIT" 1)
(setvar "DIMBLK" "_DOT")
(setvar "DIMSAH" 1)
(setvar "DIMBLK1" "_OPEN")
(setvar "DIMBLK2" "_CLOSED")
(setvar "DIMTOL" 1)
(setvar "DIMTP" 0.1)
(setvar "DIMTM" 0.05)
(setvar "DIMALT" 1)
(setvar "DIMALTF" 25.4)
(command "_.-DIMSTYLE" "_Save" "HDXF_FRACTIONAL")
(fx:idle)
(command "_.DIMLINEAR" "0,0" "150,0" "70,-20")
(fx:idle)
(command "_.UCS" "_Origin" "10,20,5")
(fx:idle)
(command "_.UCS" "_Z" "25")
(fx:idle)
(command "_.UCS" "_Named" "_Save" "HDXF_UCS")
(fx:idle)
(command "_.UCS" "_World")
(fx:idle)
(command "_.ZOOM" "_Extents")
(fx:idle)
(command "_.-VIEW" "_Save" "HDXF_PLAN")
(fx:idle)
(command "_.-VPORTS" "_2" "_Vertical")
(fx:idle)
(command "_.-VPORTS" "_Save" "HDXF_TWO")
(fx:idle)
(regapp "HDXF_FACIT")
(entmod (append (entget (tblobjname "LAYER" "HDXF_RGB")) '((-3 ("HDXF_FACIT" (1000 . "layer metadata") (1040 . 1.25) (1071 . 1234567))))))
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_layers_styles.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_layers_styles_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
; Change one property at a time; separate before/after filenames.
(setvar "DIMLUNIT" 2)
(command "_.-DIMSTYLE" "_Save" "HDXF_FRACTIONAL" "_Yes")
(fx:idle)
(command "_.REGENALL")
(fx:idle)
(foreach pair '(("r12" "R12") ("2000" "2000") ("2004" "2004") ("2007" "2007") ("2010" "2010") ("2013" "2013") ("2018" "2018")) (setq v (cadr pair) path (strcat fx:base "acad_" (car pair) "_dxf_layers_styles_dimstyle_changed.dxf")) (command "_.SAVEAS" "DXF" "_V" v "16" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)) (setq path (strcat fx:base "acad_" (car pair) "_dxf_layers_styles_dimstyle_changed_bin.dxf")) (command "_.SAVEAS" "DXF" "_V" v "_B" path) (if (/= 0 (logand (getvar "CMDACTIVE") 3)) (command "_Y")) (fx:idle) (fx:need (findfile path) (strcat "Missing output " path)))
(setvar "FILEDIA" 1)
(setvar "CMDDIA" 1)
(princ "\nKLAR 07_layers_styles\n")
